\":3.1856626,\"distance\":926,\"duration\":11.023809523809524},{\"name\":\"KK Super Mart\",\"type\":\"CONVENIENCE_STORE\",\"longitude\":101.6599696,\"latitude\":3.1839055,\"distance\":977,\"duration\":11.630952380952381}],\"distance\":null,\"discount\":0,\"deleteReason\":\"\",\"securityDeposit\":2300,\"utilitiesDeposit\":0,\"approvalStatus\":\"APPROVED\",\"availability\":\"2026-02-14T00:00:00\",\"expiryDate\":\"2026-07-21T07:00:03\",\"lastUpdated\":\"2026-06-08T00:04:21\",\"productType\":\"DEFAULT\",\"managed\":false,\"lastReviewedBy\":\"logeswary@speedrent.com\",\"landmarkLabelId\":\"Vt1RTZIB3oBtfxXgdDOK\",\"landmarkLabelVerified\":true,\"saleType\":null,\"leaseType\":null,\"bumiLot\":false,\"dateActivated\":\"2026-05-22T07:00:02\",\"KOH\":false,\"dateCreated\":\"2026-02-04T14:55:53\",\"allowWhatsappAutomation\":false,\"boostExpiry\":\"2026-02-06T14:55:53\",\"videos\":[],\"chatServerConversationId\":null,\"descriptionLastUpdate\":\"\",\"descriptionLastUpdateBy\":null,\"descriptionLastUpdateAt\":null,\"stats\":{\"id\":322486,\"crCount\":2,\"viewCount\":5034,\"reactivateCount\":3,\"searchRankingScore\":633,\"searchRankingScoreLastUpdated\":\"2026-06-08T15:13:29\",\"dateCreated\":\"2026-02-04T14:55:53\",\"lastUpdated\":\"2026-06-08T18:53:12\"},\"hotDealsPropertyDto\":{\"id\":118217,\"bannerDescription\":\"Newly created listing\",\"criteria\":\"Newly created listing\",\"category\":\"New Listing\",\"showBanner\":false,\"active\":true},\"propertyKeyStatus\":\"NOT_COLLECTED\",\"lnaReason\":null,\"auctions\":[],\"state\":\"Wilayah Persekutuan\",\"city\":\"Kuala Lumpur\",\"country\":\"Malaysia\",\"isVirtualViewingSupported\":false,\"hotDealsId\":2,\"mogp\":false,\"favourite\":false,\"robot\":null,\"propertyVirtualTour\":[],\"virtualTourAvailable\":false,\"viewingAvailableDate\":\"2026-07-06T00:00:00\",\"viewingAvailabilityChangeReason\":null,\"source\":\"APP\",\"propertyProductTypes\":[{\"id\":330809,\"propertyId\":297508,\"productType\":\"DEPOSIT\",\"active\":true,\"dateCreated\":\"2026-02-04T14:55:53\",\"lastUpdated\":\"2026-02-04T14:55:53\"},{\"id\":330810,\"propertyId\":297508,\"productType\":\"INSURANCE\",\"active\":true,\"dateCreated\":\"2026-02-04T14:55:53\",\"lastUpdated\":\"2026-02-04T14:55:53\"}],\"autoPreferredViewingTime\":false,\"preferredViewingTimes\":[],\"propertyGuideId\":null,\"propertyTenantPreference\":{\"malaysian\":\"ALL\",\"foreigner\":\"ALL\",\"petFriendly\":\"ALL\",\"profession\":\"ALL\",\"tenancyDuration\":12,\"isMuslim\":false,\"totalTenantAllowed\":1,\"gender\":\"ALL\",\"country\":[\"ALL\"]},\"propertyVerified\":true,\"priceStatistics\":{\"minPrice\":2350,\"maxPrice\":2600,\"medianPrice\":2600,\"market75Price\":2600,\"market90Price\":2600},\"propertyRating\":null,\"propertyUtility\":{\"id\":2898,\"code\":\"https://speedrent-classified.s3.ap-southeast-1.amazonaws.com/property_utility/297508/property_utility_297508.pdf?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20260608T185955Z&X-Amz-SignedHeaders=host&X-Amz-Expires=3600&X-Amz-Credential=AKIAZIC2K7J72QHKGBZJ%2F20260608%2Fap-southeast-1%2Fs3%2Faws4_request&X-Amz-Signature=f85b6d15565ec7f697643d4646a617713d52093e057b2678b830e3f784aa3c03\",\"status\":\"REJECTED\"},\"outOfCoverageArea\":false,\"slug\":\"savio-riana-dutamas-segambut-ajgluwcp\",\"aiDescription\":{\"en\":\"Discover a cozy family haven at Savio Riana Dutamas, Segambut! This 800 sqft, 2-bedroom, 2-bathroom unit offers a comfortable and well-appointed living space. Fully furnished with modern essentials, it's ready for your family to move in. The bright living area, complemented by ample natural light, creates a warm and inviting atmosphere. The property boasts excellent family-friendly facilities including a children's playground, BBQ area, and a refreshing swimming pool, perfect for weekend fun. With efficient lift service, navigating the building is a breeze. Your family will appreciate the nearby conveniences, such as a CONVENIENCE_STORE (300m) and RESTAURANT (500m), along with access to a SCHOOL (within 2km, exact distance to be confirmed). Enjoy peace of mind with 24hr security and covered parking for one vehicle. This is a practical and welcoming home for your growing family.\",\"my\":\"Temui syurga keluarga yang selesa di Savio Riana Dutamas, Segambut! Unit 800 kaki persegi, 2 bilik tidur, 2 bilik air ini menawarkan ruang tamu yang selesa dan serba lengkap. Dilengkapi sepenuhnya dengan keperluan moden, ia sedia untuk keluarga anda berpindah masuk. Kawasan tamu yang terang, dilengkapi cahaya semula jadi yang mencukupi, mewujudkan suasana yang hangat dan menarik. Hartanah ini mempunyai kemudahan mesra keluarga yang sangat baik termasuk taman permainan kanak-kanak, kawasan BBQ, dan kolam renang yang menyegarkan. Dengan perkhidmatan lif yang cekap, bergerak di sekitar bangunan adalah mudah. Keluarga anda akan menghargai kemudahan berdekatan, seperti KEDAI RUNCIT (300m) dan RESTORAN (500m), bersama akses ke SEKOLAH (dalam 2km, jarak tepat akan disahkan)...\",\"cn\":\"在Savio Riana Dutamas, Segambut 发现一个舒适的家庭港湾！这个800平方英尺的2卧室2浴室单位提供舒适且设施齐全的生活空间。全套现代化家具，适合您的家庭入住。明亮的起居区，充足的自然光线，营造出温馨宜人的氛围。该房产拥有绝佳的家庭友好设施，包括儿童游乐场、烧烤区和清爽的游泳池，非常适合周末的欢乐时光。高效的电梯服务，轻松便捷地在楼宇内穿梭。您的家人会欣赏附近的便利设施，如便利店（300米）和餐厅（500米），以及学校（2公里内，具体距离待确认）。享受24小时安保和一辆车的有盖停车位，让您安心。这是一个实用且温馨的家，适合您不断成长的家庭。\"},\"isRented\":true,\"marketingStatus\":null,\"marketingStatusLabel\":null,\"tenantStatus\":null,\"chatRequestCount\":2,\"viewingAppointmentCount\":1,\"uniqueViewCount\":null},{\"id\":292656,\"user\":{\"id\":982976,\"name\":\"MAYBANK ISLAMIC BERHAD\",\"avatar\":null,\"avatarImageUrl\":null,\"phoneNumber\":null,\"userStatsDto\":null,\"isVerifiedLandlord\":null,\"isVerifiedUser\":true},\"ref\":\"WZSKAVNT\",\"name\":\"Duta Ria Condominium\",\"address\":\"Duta Ria Condominium, Jalan Dutamas Raya, Segambut, 51200 Kuala Lumpur\",\"level\":\"12\",\"storeys\":null,\"type\":\"HIGHRISE\",\"furnishType\":\"PARTIAL\",\"roomType\":null,\"bathroomType\":null,\"status\":\"ACTIVE\",\"active\":true,\"instantView\":true,\"noDeposit