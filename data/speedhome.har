 height=\"1em\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z\"></path></svg></a></div><div class=\"Navbar_iconLink__jkKkL\"><div class=\"Navbar_profileIconWrapper__lfjkc\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z\"></path></svg></div></div></div></div></div></div></div></div><main class=\"Layout_innerContainer__Lnyfz \" style=\"height:auto;margin:0 auto;width:100%\"><main id=\"main\" class=\"AboutPage_page__hkhZk\"><nav class=\"LandingTabs_tabs__rffHc\" aria-label=\"Brand sections\"><div class=\"LandingTabs_tabsRow__4U_sm\"><a class=\"LandingTabs_tab__gxOcd LandingTabs_tabActive__rZ7hB\" aria-current=\"page\" href=\"/more/landlord/about-us\">About Us</a><a class=\"LandingTabs_tab__gxOcd \" href=\"/more/landlord/speedhome\">SPEEDHOME</a><a class=\"LandingTabs_tab__gxOcd \" href=\"/more/landlord/speedreno\">SPEEDRENO</a><a class=\"LandingTabs_tab__gxOcd \" href=\"/more/landlord/speedfix\">SPEEDFIX</a></div></nav><section class=\"AboutPage_hero__UBwsO\"><img alt=\"SPEEDHOME GROUP\" width=\"247\" height=\"63\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_heroLogo__bD6rO\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fspeedhome_group_logo.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fspeedhome_group_logo.png&amp;w=512&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fspeedhome_group_logo.png&amp;w=512&amp;q=75\"/><div class=\"AboutPage_heroCopy__6XIcr\"><h1 class=\"AboutPage_heroTitle__T4zTf text-v2-display-l\">Your rental shouldn&#x27;t be a second job.</h1><p class=\"AboutPage_heroSubtitle__PBbJ2 text-v2-h1-regular\">We get the unit ready, get it rented, and handle what comes after.</p></div><div class=\"AboutPage_heroCards__I13sf\"><a class=\"AboutPage_heroCard__3yBh9\" href=\"/more/landlord/speedreno\"><img alt=\"\" loading=\"lazy\" width=\"86\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_heroCardIcon__IXe58\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fbefore_listing.svg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fbefore_listing.svg&amp;w=176&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fbefore_listing.svg&amp;w=176&amp;q=75\"/><div class=\"AboutPage_heroCardCopy__3CWT_\"><p class=\"AboutPage_heroCardTitle__yhKLm text-v2-h1-regular\">Before Listing</p><p class=\"AboutPage_heroCardSub__am9bz text-v2-p3-regular\">Speedreno</p></div></a><a class=\"AboutPage_heroCard__3yBh9\" href=\"/more/landlord/speedhome\"><img alt=\"\" loading=\"lazy\" width=\"86\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_heroCardIcon__IXe58\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Ffind_tenant.svg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Ffind_tenant.svg&amp;w=176&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Ffind_tenant.svg&amp;w=176&amp;q=75\"/><div class=\"AboutPage_heroCardCopy__3CWT_\"><p class=\"AboutPage_heroCardTitle__yhKLm text-v2-h1-regular\">Find Tenant</p><p class=\"AboutPage_heroCardSub__am9bz text-v2-p3-regular\">Speedhome</p></div></a><a class=\"AboutPage_heroCard__3yBh9\" href=\"/more/landlord/speedfix\"><img alt=\"\" loading=\"lazy\" width=\"86\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_heroCardIcon__IXe58\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fafter_move_in.svg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fafter_move_in.svg&amp;w=176&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fafter_move_in.svg&amp;w=176&amp;q=75\"/><div class=\"AboutPage_heroCardCopy__3CWT_\"><p class=\"AboutPage_heroCardTitle__yhKLm text-v2-h1-regular\">After Move In</p><p class=\"AboutPage_heroCardSub__am9bz text-v2-p3-regular\">Speedfix</p></div></a></div></section><section class=\"AboutPage_trustStrip___pPAd\"><div class=\"AboutPage_trustItem__ej7Rv\"><p class=\"AboutPage_trustHeadline__fpuV_ text-v2-display-s\">Zero</p><p class=\"AboutPage_trustSubline__5_WYt text-v2-h1-regular\">Listing Fees</p></div><div class=\"AboutPage_trustItem__ej7Rv\"><p class=\"AboutPage_trustHeadline__fpuV_ text-v2-display-s\">21 Days</p><p class=\"AboutPage_trustSubline__5_WYt text-v2-h1-regular\">to Rent Out</p></div><div class=\"AboutPage_trustItem__ej7Rv AboutPage_trustItemWide__flCIj\"><p class=\"AboutPage_trustHeadline__fpuV_ text-v2-display-s\">5,000+</p><p class=\"AboutPage_trustSubline__5_WYt text-v2-h1-regular\">Landlords Trust Us</p></div><div class=\"AboutPage_trustAllianz__niYBe\"><p class=\"AboutPage_trustPoweredBy__OM4LM\">Powered By</p><img alt=\"Allianz\" loading=\"lazy\" width=\"186\" height=\"48\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_allianzLogo__XcqCj\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fallianz.svg&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fallianz.svg&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fallianz.svg&amp;w=384&amp;q=75\"/></div></section><section class=\"AboutPage_handoverGap__pTr4M\"><h2 class=\"AboutPage_handoverTitle__Gv3Ab text-v2-display-l\">The Handover Gap</h2><p class=\"AboutPage_handoverSubtitle__jBUvT text-v2-h1-regular\">Most landlords hire separate people for each part of the rental. Each one leaves once their part is done.</p><div class=\"AboutPage_handoverCards__jQ_hA\"><div class=\"AboutPage_handoverCard__q8Oed\"><img alt=\"The contractor after the handover.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_handoverCardImage__g0OUi\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 240px, 480px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=16&amp;q=95 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=32&amp;q=95 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=48&amp;q=95 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=64&amp;q=95 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=96&amp;q=95 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=128&amp;q=95 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=176&amp;q=95 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=256&amp;q=95 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=340&amp;q=95 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=384&amp;q=95 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=512&amp;q=95 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=640&amp;q=95 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=768&amp;q=95 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=1024&amp;q=95 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=1280&amp;q=95 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=1600&amp;q=95 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fcontractor.png&amp;w=1600&amp;q=95\"/></div><div class=\"AboutPage_handoverCard__q8Oed\"><img alt=\"The agent after signing.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_handoverCardImage__g0OUi\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 240px, 480px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=16&amp;q=95 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=32&amp;q=95 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=48&amp;q=95 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=64&amp;q=95 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=96&amp;q=95 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=128&amp;q=95 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=176&amp;q=95 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=256&amp;q=95 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=340&amp;q=95 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=384&amp;q=95 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=512&amp;q=95 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=640&amp;q=95 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=768&amp;q=95 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=1024&amp;q=95 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=1280&amp;q=95 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=1600&amp;q=95 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fagent.png&amp;w=1600&amp;q=95\"/></div><div class=\"AboutPage_handoverCard__q8Oed\"><img alt=\"The handyman after one fix.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_handoverCardImage__g0OUi\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 240px, 480px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=16&amp;q=95 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=32&amp;q=95 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=48&amp;q=95 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=64&amp;q=95 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=96&amp;q=95 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=128&amp;q=95 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=176&amp;q=95 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=256&amp;q=95 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=340&amp;q=95 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=384&amp;q=95 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=512&amp;q=95 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=640&amp;q=95 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=768&amp;q=95 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=1024&amp;q=95 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=1280&amp;q=95 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=1600&amp;q=95 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Fhandyman.png&amp;w=1600&amp;q=95\"/></div></div><p class=\"AboutPage_handoverNote__3RmNw text-v2-display-s\"><span>Not because anyone </span>failed<span>. Because it is </span>nobody&#x27;s job<span> in between.</span></p></section><div class=\"AboutPage_sectionDivider__RXNrX\"></div><section class=\"AboutPage_start__iSz1k\"><h2 class=\"AboutPage_startTitle__Eut04 text-v2-display-l\">Start where it matters most.</h2><p class=\"AboutPage_startSubtitle__X40fi text-v2-h1-regular\">Don&#x27;t know where to start? We help you decide how to rent it before you spend anything.</p><div class=\"AboutPage_startCards__Vu_6P\"><div class=\"AboutPage_startCard__DoQtD\"><div class=\"AboutPage_startCardImageWrap__2Owtr AboutPage_startCardImageWrap_tenancy__ShHxC\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_startCardImage__KxIMi \" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 336px, 672px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=16&amp;q=90 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=32&amp;q=90 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=48&amp;q=90 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=64&amp;q=90 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=96&amp;q=90 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=128&amp;q=90 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=176&amp;q=90 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=256&amp;q=90 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=340&amp;q=90 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=384&amp;q=90 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=512&amp;q=90 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=640&amp;q=90 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=768&amp;q=90 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=1024&amp;q=90 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=1280&amp;q=90 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=1600&amp;q=90 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Ftenancy_mgmt.png&amp;w=1600&amp;q=90\"/></div><img alt=\"SPEEDHOME\" loading=\"lazy\" width=\"115\" height=\"20\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_startCardLogo__CwoCP AboutPage_startCardLogo_tenancy__895iV\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fshome_logo.svg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fshome_logo.svg&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fshome_logo.svg&amp;w=256&amp;q=75\"/><h3 class=\"AboutPage_startCardTitle__da8Xs text-v2-h1\">Tenancy Management</h3><p class=\"AboutPage_startCardDesc__Bbf_T text-v2-p3-regular\">You approve the tenant and set the rent. Invoicing and reminders run automatically and when it matters, we step in.</p></div><div class=\"AboutPage_startCard__DoQtD\"><div class=\"AboutPage_startCardImageWrap__2Owtr AboutPage_startCardImageWrap_unit__Zxqk5\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_startCardImage__KxIMi \" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 336px, 672px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=16&amp;q=90 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=32&amp;q=90 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=48&amp;q=90 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=64&amp;q=90 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=96&amp;q=90 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=128&amp;q=90 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=176&amp;q=90 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=256&amp;q=90 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=340&amp;q=90 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=384&amp;q=90 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=512&amp;q=90 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=640&amp;q=90 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=768&amp;q=90 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=1024&amp;q=90 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=1280&amp;q=90 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=1600&amp;q=90 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Funit_prep.png&amp;w=1600&amp;q=90\"/></div><div class=\"AboutPage_startCardGradient__elFpu\" aria-hidden=\"true\"></div><img alt=\"SPEEDRENO\" loading=\"lazy\" width=\"106\" height=\"20\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_startCardLogo__CwoCP AboutPage_startCardLogo_unit___L5Pu\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsreno_logo.svg&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsreno_logo.svg&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsreno_logo.svg&amp;w=256&amp;q=75\"/><h3 class=\"AboutPage_startCardTitle__da8Xs text-v2-h1\">Unit Preparation</h3><p class=\"AboutPage_startCardDesc__Bbf_T text-v2-p3-regular\">Set your budget and scope. We manage the renovation, coordinate contractors, and get the unit rent-ready.</p></div><div class=\"AboutPage_startCard__DoQtD\"><div class=\"AboutPage_startCardImageWrap__2Owtr AboutPage_startCardImageWrap_repairs__iz1N_\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"AboutPage_startCardImage__KxIMi AboutPage_startCardImageRepairs__If_dt\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1280px) 336px, 672px\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=16&amp;q=90 16w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=32&amp;q=90 32w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=48&amp;q=90 48w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=64&amp;q=90 64w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=96&amp;q=90 96w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=128&amp;q=90 128w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=176&amp;q=90 176w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=256&amp;q=90 256w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=340&amp;q=90 340w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=384&amp;q=90 384w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=512&amp;q=90 512w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=640&amp;q=90 640w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=768&amp;q=90 768w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=1024&amp;q=90 1024w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=1280&amp;q=90 1280w, /_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=1600&amp;q=90 1600w\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Fphotos%2Frepairs.png&amp;w=1600&amp;q=90\"/></div><img alt=\"SPEEDFIX\" loading=\"lazy\" width=\"84\" height=\"20\" decoding=\"async\" data-nimg=\"1\" class=\"AboutPage_startCardLogo__CwoCP AboutPage_startCardLogo_repairs__LGKY1\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsfix_logo.svg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsfix_logo.svg&amp;w=176&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2Fabout_us_v2%2Ficons%2Fsfix_logo.svg&amp;w=176&amp;q=75\"/><h3 class=\"AboutPage_startCardTitle__da8Xs text-v2-h1\">Repairs</h3><p class=\"AboutPage_startCardDesc__Bbf_T text-v2-p3-regular\">Tenant reports the issue. We dispatch a vetted vendor, get it fixed, and settle the cost through your payout.</p></div></div></section><div class=\"AboutPage_sectionDivider__RXNrX\"></div><section class=\"AboutPage_fallback__OZPLj\"><h2 class=\"AboutPage_fallbackTitle__r6uMR text-v2-display-l\">A rental should not keep falling back on you.</h2><p class=\"AboutPage_fallbackSubtitle__MFFV4 text-v2-h1-regular\">We get the unit ready, get it rented, collect the rent, and handle repairs — from move-in to move-out. Quit your second job.</p><div class=\"AboutPage_fallbackList__9O6ow\"><a class=\"AboutPage_fallbackItem__Z3WP6\" href=\"/more/landlord/speedreno\"><div class=\"AboutPage_fallbackItemContent__z5RHg\"><p class=\"AboutPage_fallbackItemLabel__VmZ5H\">Before Move In</p><p class=\"AboutPage_fallbackItemTitle__U7ugG\">Prepare unit for rent</p><p class=\"AboutPage_fallbackItemDesc__oLWYh text-v2-h3-regular\">Everything you need to get your property rent-ready</p></div><svg class=\"AboutPage_fallbackChevron___p5bA\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a><a class=\"AboutPage_fallbackItem__Z3WP6\" href=\"/more/landlord/speedhome\"><div class=\"AboutPage_fallbackItemContent__z5RHg\"><p class=\"AboutPage_fallbackItemLabel__VmZ5H\">After Move In</p><p class=\"AboutPage_fallbackItemTitle__U7ugG\">Automated rent collection to guaranteed payouts</p><p class=\"AboutPage_fallbackItemDesc__oLWYh text-v2-h3-regular\">Choose how much we handle</p></div><svg class=\"AboutPage_fallbackChevron___p5bA\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a><a class=\"AboutPage_fallbackItem__Z3WP6\" href=\"/more/landlord/speedfix\"><div class=\"AboutPage_fallbackItemContent__z5RHg\"><p class=\"AboutPage_fallbackItemLabel__VmZ5H\">During Tenancy</p><p class=\"AboutPage_fallbackItemTitle__U7ugG\">Fix repairs faster</p><p class=\"AboutPage_fallbackItemDesc__oLWYh text-v2-h3-regular\">Log, track, and resolve maintenance issues with ease</p></div><svg class=\"AboutPage_fallbackChevron___p5bA\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a></div></section><div class=\"AboutPage_sectionDivider__RXNrX\"></div><div class=\"Testimonials_testimonialWrapper__PIQxp\"><div class=\"Testimonials_container__X60H0\"><h2 class=\"Testimonials_title__FVo4O text-v2-h1\">Our Testimonials</h2><div class=\"Testimonials_swiperContainer__b0WMF\"><div class=\"EmblaCarousel_embla__LHhmA \"><div class=\"EmblaCarousel_emblaViewport__xtiWc\"><div class=\"EmblaCarousel_emblaContainer__IzNvu \" style=\"gap:24px;--slides-per-view:2\"><div class=\"EmblaCarousel_emblaSlide__AMA3o \"><div class=\"Testimonials_testimonialCard__S2AnG\"><div class=\"Testimonials_rating__OS8Za\"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div><p class=\"Testimonials_content__UeHXk\">I had trouble keeping up payment from my previous tenants. Some months I have to make time to knock on their door for overdue payments. Now SPEEDHOME chases tenant for tardy payment and monthly rentcheck is just a click away.</p><div class=\"Testimonials_profile__8tR1l\"><div class=\"Testimonials_avatarWrapper__zWEyb\"><img alt=\"SALLAHUDDIN\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"Testimonials_avatarImage__KaJ0V\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2FSallahuddin.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimg%2FSallahuddin.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2FSallahuddin.jpg&amp;w=96&amp;q=75\"/></div><span class=\"Testimonials_name__Y1n04\">SALLAHUDDIN</span></div></div></div><div class=\"EmblaCarousel_emblaSlide__AMA3o \"><div class=\"Testimonials_testimonialCard__S2AnG\"><div class=\"Testimonials_rating__OS8Za\"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div><p class=\"Testimonials_content__UeHXk\">My previous tenant from hell caused me 5 figures worth of rental loss and property damage! Luckily, through using SPEEDHOME, I was able to recover through this by claiming this lost money back!</p><div class=\"Testimonials_profile__8tR1l\"><div class=\"Testimonials_avatarWrapper__zWEyb\"><img alt=\"ADRIAN\" loading=\"lazy\" width=\"40\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"Testimonials_avatarImage__KaJ0V\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimg%2FAdrian.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimg%2FAdrian.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Fimg%2FAdrian.jpg&amp;w=96&amp;q=75\"/></div><span class=\"Testimonials_name__Y1n04\">ADRIAN</span></div></div></div></div></div></div></div></div></div><section class=\"YellowCtaBand_band__zGOGg\"><p class=\"YellowCtaBand_text__RRGji text-v2-h1\" style=\"width:449px\">A rental should be a gain, not a drain.</p><a class=\"YellowCtaBand_ctaWrap__g_LU7\" href=\"/more/landlord/speedhome\"><button class=\"ButtonV2_btn__Sy_KE ButtonV2_primary___ekHj ButtonV2_lg__vgdxB YellowCtaBand_cta__PXXrS\" type=\"button\">Start The Process</button></a></section><div class=\"YellowCtaBand_floatingBar__CxH46 \" aria-hidden=\"true\"><a class=\"YellowCtaBand_ctaWrap__g_LU7\" href=\"/more/landlord/speedhome\"><button class=\"ButtonV2_btn__Sy_KE ButtonV2_primary___ekHj ButtonV2_lg__vgdxB YellowCtaBand_cta__PXXrS\" type=\"button\">Start The Process</button></a></div></main></main><div id=\"wrapfabtest\"><div></div></div></div></div></div><div id=\"datepicker-portal\"></div></div><scrip