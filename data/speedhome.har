0,\"utilitiesDeposit\":0,\"approvalStatus\":\"APPROVED\",\"availability\":\"2026-05-29T00:00:00\",\"expiryDate\":\"2026-06-21T21:13:01\",\"lastUpdated\":\"2026-05-22T21:13:01\",\"productType\":\"DEFAULT\",\"managed\":false,\"lastReviewedBy\":\"nuramanina.wanmahadzir@speedrent.com\",\"landmarkLabelId\":\"yjI7j5EBpqtbwvnCh6oU\",\"landmarkLabelVerified\":true,\"saleType\":null,\"leaseType\":null,\"bumiLot\":false,\"dateActivated\":\"2026-05-02T16:57:08\",\"KOH\":false,\"dateCreated\":\"2026-05-02T16:57:08\",\"allowWhatsappAutomation\":false,\"boostExpiry\":\"2026-05-04T16:57:08\",\"videos\":[],\"chatServerConversationId\":null,\"descriptionLastUpdate\":\"\",\"descriptionLastUpdateBy\":null,\"descriptionLastUpdateAt\":null,\"stats\":{\"id\":324771,\"crCount\":10,\"viewCount\":10501,\"reactivateCount\":1,\"searchRankingScore\":32,\"searchRankingScoreLastUpdated\":\"2026-06-08T15:15:02\",\"dateCreated\":\"2026-05-02T16:57:08\",\"lastUpdated\":\"2026-06-08T17:53:14\"},\"hotDealsPropertyDto\":{\"id\":120555,\"bannerDescription\":\"Newly created listing\",\"criteria\":\"Newly created listing\",\"category\":\"New Listing\",\"showBanner\":false,\"active\":true},\"propertyKeyStatus\":\"NOT_COLLECTED\",\"lnaReason\":null,\"auctions\":[],\"state\":\"Wilayah Persekutuan\",\"city\":\"Kuala Lumpur\",\"country\":\"Malaysia\",\"isVirtualViewingSupported\":false,\"hotDealsId\":2,\"mogp\":false,\"favourite\":false,\"robot\":null,\"propertyVirtualTour\":[],\"virtualTourAvailable\":false,\"viewingAvailableDate\":\"2026-05-27T00:00:00\",\"viewingAvailabilityChangeReason\":null,\"source\":\"APP\",\"propertyProductTypes\":[{\"id\":334844,\"propertyId\":299793,\"productType\":\"DEPOSIT\",\"active\":true,\"dateCreated\":\"2026-05-02T17:21:54\",\"lastUpdated\":\"2026-05-02T17:21:54\"},{\"id\":334842,\"propertyId\":299793,\"productType\":\"INSURANCE\",\"active\":true,\"dateCreated\":\"2026-05-02T16:57:08\",\"lastUpdated\":\"2026-05-02T16:57:08\"}],\"autoPreferredViewingTime\":false,\"preferredViewingTimes\":[{\"days\":[6,0],\"startHour\":10,\"endHour\":18},{\"days\":[2,3,4,5,1],\"startHour\":13,\"endHour\":20}],\"propertyGuideId\":null,\"propertyTenantPreference\":{\"malaysian\":\"ALL\",\"foreigner\":\"ALL\",\"petFriendly\":\"NONE\",\"profession\":\"ALL\",\"tenancyDuration\":12,\"isMuslim\":false,\"totalTenantAllowed\":4,\"gender\":\"ALL\",\"country\":[\"ALL\"]},\"propertyVerified\":true,\"priceStatistics\":{\"minPrice\":3300,\"maxPrice\":3400,\"medianPrice\":3300,\"market75Price\":3400,\"market90Price\":3400},\"propertyRating\":null,\"propertyUtility\":{\"id\":3943,\"code\":\"https://speedrent-classified.s3.ap-southeast-1.amazonaws.com/property_utility/299793/property_utility_299793.pdf?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20260608T185955Z&X-Amz-SignedHeaders=host&X-Amz-Expires=3600&X-Amz-Credential=AKIAZIC2K7J72QHKGBZJ%2F20260608%2Fap-southeast-1%2Fs3%2Faws4_request&X-Amz-Signature=89a551d7449455b67bdcd0caaa770cb8137d6a90639b45500c3cbea32c4cc8fc\",\"status\":\"REJECTED\"},\"outOfCoverageArea\":false,\"slug\":\"duta-park-residences-pqdvkwmw\",\"aiDescription\":{\"en\":\"This 3-bedroom, 2-bathroom fully furnished unit spans 1,129 sqft in the Duta Park Residences development near KLCC. The layout includes a combined living and dining area with practical furnishings throughout, including built-in wardrobes in all bedrooms. Two covered parking spaces are included. Schools including Big Ben Education Group and Advance Tertiary College are within a <2km drive. A mosque is within a <500m walk, supporting daily religious needs. Grocery options such as Cold Storage KLCC and Village Grocer are within a <2km drive. Clinic access is available within a <500m walk. The residential neighbourhood includes established properties like Tropicana The Residence and Kirana Residences. Multiple convenience stores and pharmacies are available within a 5-10 min walk, and family dining options including mamak are within a <2km drive.\",\"my\":\"Unit 3 bilik tidur, 2 bilik air lengkap berperabot seluas 1,129 kaki persegi di Duta Park Residences berhampiran KLCC. Susun atur termasuk ruang tamu dan makan gabungan dengan peralatan praktikal sepanjang bangunan. Dua tempat letak kereta berbumbung disediakan. Sekolah seperti Big Ben Education Group dan Advance Tertiary College dalam <2km pandu. Masjid dalam <500m jalan. Pilihan runcit seperti Cold Storage KLCC dan Village Grocer dalam <2km pandu. Akses klinik dalam <500m jalan. Kawasan perumahan termasuk Tropicana The Residence dan Kirana Residences. Kedai serbaneka dan farmasi dalam 5-10 min jalan.\",\"cn\":\"这套3卧室2浴室全装修单位位于Duta Park Residences，靠近吉隆坡市中心，面积为1,129平方英尺。布局包括开放式客厅和餐厅，配备实用家具，所有卧室均配有嵌入式衣柜。配备两个有盖停车位。Big Ben Education Group和Advance Tertiary College等学校在<2公里车程内。 Masjid在<500米步行范围内。Cold Storage KLCC和Village Grocer等杂货店在<2公里车程内。诊所在<500米步行范围内。住宅区包括Tropicana The Residence和Kirana Residences。多处便利店和药房在5-10分钟步行范围内，嘛嘛档等家庭餐厅在<2公里车程内。\"},\"isRented\":false,\"marketingStatus\":null,\"marketingStatusLabel\":null,\"tenantStatus\":null,\"chatRequestCount\":10,\"viewingAppointmentCount\":3,\"uniqueViewCount\":null},{\"id\":299487,\"user\":{\"id\":3261694,\"name\":\"lee chin kuan\",\"avatar\":\"https://image.speedhome.com/speedrent-backend/images/avatar/QBTPTOL8WWNCC7HH/avatar-medium.jpg\",\"avatarImageUrl\":\"https://image.speedhome.com/speedrent-backend/images/avatar/QBTPTOL8WWNCC7HH/avatar\",\"phoneNumber\":null,\"userStatsDto\":null,\"isVerifiedLandlord\":null,\"isVerifiedUser\":false},\"ref\":\"QQWZIJCO\",\"name\":\"The ERA, Segambut\",\"address\":\"Jalan Segambut, 51200, Kuala Lumpur, Wilayah Persekutuan, 51200 Kuala Lumpur, Malaysia\",\"level\":\"1\",\"storeys\":null,\"type\":\"ROOM\",\"furnishType\":\"FULL\",\"roomType\":\"MEDIUM\",\"bathroomType\":\"SHARED\",\"status\":\"ACTIVE\",\"active\":true,\"instantView\":true,\"noDeposit\":true,\"fullyFurnishable\":false,\"negotiable\":true,\"owner\":true,\"sqft\":958,\"bedroom\":1,\"bathroom\":1,\"carpark\":2,\"roommate\":1,\"price\":700,\"postcode\":\"51200\",\"unitNumber\":\"D-33A-01\",\"latitude\":3.1819735165,\"longitude\":101.6753232479,\"description\":\"✅ Renting By Room — Floor 33A | New Building | 4-Bedroom Unit\\r\\n\\r\\n🏠 4-Bedroom, 2-Bathroom unit\\r\\n4 persons max — 1 person per room, no room sharing\\r\\nClean, comfortable & respectful living environment\\r\\n\\r\\n💡 AVAILABLE ROOMS & RENTAL:\\r\\n🌿 Balcony Room (with private balcony) — RM950/month (negotiable)\\r\\n🛏 Medium Room — RM900/month (negotiable)\\r\\n🏠 Small Room — RM700/month (negotiable)\\r\\n🚗 Car Park — RM200/month (optional)\\r\\n\\r\\n❌ Master Room, Medium Room, Balcony Room — Already Rented Out\\n📌 Each room is rented individually — contact us to check availability!\\r\\n\\r\\n‼ EACH ROOM INCLUDES ‼\\r\\n✅ AIRCON (Midea) — separate meter, charged by usage\\r\\n✅ WATER & ELECTRICITY INCLUDED IN RENT\\r\\n✅ Bed with Bed Frame, Bed Sheet, 2 Pillows & Pillow Cases (as shown in pictures)\\r\\n — Queen Size (Balcony & Medium Room) | Super Single (Small Room)\\r\\n✅ WARDROBE WITH MIRROR\\r\\n\\r\\n🌆 ROOM VIEWS:\\r\\n🌿 Balcony Room — Stunning unobstructed open sky view, wake up to open skies every day ☁️\\r\\n🛏 Medium Room — Direct view of KLCC Twin Towers, Merdeka 118 & KL Tower 🏙️\\r\\n🏠 Small Room — Stunning unobstructed open sky view ☁️\\r\\n\\r\\n‼ COMMON AREA INCLUDES ‼\\r\\n✅ ELECTRICAL DOOR LOCK — keyless, secure & convenient unit entry\\r\\n✅ WATER DISPENSER\\r\\n✅ MIDEA REFRIGERATOR\\r\\n✅ SAMSUNG MICROWAVE\\r\\n✅ MIDEA WASHING MACHINE & DRYER\\r\\n✅ FREE WiFi 200Mbps — NO limits\\r\\n✅ FREE Common Area Cleaning Service (once per month)\\r\\n\\r\\n🏊 PODIUM FACILITIES ‼\\r\\n✅ Huge Swimming Pool\\r\\n✅ Basketball Court\\r\\n✅ 2 Spacious Gyms\\r\\n✅ Treehouse & Lush Greenery\\r\\n✅ Scenic Ponds\\r\\n\\r\\n🌇 ROOFTOP ACCESS ‼\\r\\n✅ Access to the highest floor of The ERA\\r\\n✅ Unobstructed 360° view of entire Kuala Lumpur\\r\\n✅ See KL Tower, KLCC Twin Towers, Merdeka 118 & MITEC all at once!\\r\\n— Perfect for evening hangouts & stunning night views 🌃\\r\\n\\r\\n!! LOCATION & AMENITIES !!\\r\\n✅ ~4 mins drive to Publika & Mont Kiara\\r\\n✅ Near Segambut KTM Station & Titiwangsa Monorail Station\\r\\n✅ Upcoming MRT only 1.4km away\\r\\n✅ Easy access to KLCC, Mid Valley, KL Sentral & Damansara\\r\\n✅ 24-hour security\\r\\n\\r\\n🛍 RIGHT AT YOUR DOORSTEP (within The ERA):\\r\\n✅ NSK Grocer — Opening Soon!\\r\\n✅ RHB Bank\\r\\n✅ 7-Eleven\\r\\n✅ AEON Wellness\\r\\n✅ Restaurant\\r\\n✅ Pet Friendly Building 🐾\\r\\n\\r\\n💰 Rental by room — from RM700/month (negotiable)\\r\\n🚗 Speed Ramp Covered Car Park — RM200/month (optional)\\r\\n\\r\\n💳 DEPOSIT: 2 months deposit required upon signing\\r\\n\\r\\n📲 Interested? WhatsApp us now to check room availability & arrange viewing!\\r\\nxxxxxx\",\"allRaces\":true,\"petFriendly\":true,\"minRentalDuration\":12,\"editorPick\":true,\"furnishes\":[\"water_heater\",\"ac\",\"microwave\",\"internet\",\"washing_machine\",\"bed_frame\",\"mattress\",\"kitchen_cabinet\",\"dining_table\",\"wardrobe\",\"fridge\",\"curtain\",\"hood\"],\"utilityTypes\":[\"WATER\",\"ELECTRICITY\",\"INTERNET\"],\"facilities\":[\"gym\",\"restaurant\",\"playground\",\"basketball\",\"elevator\",\"bbq\",\"security24hr\",\"covered_parking\",\"swimming\"],\"images\":[{\"id\":1868718,\"propertyId\":299487,\"imageId\":1896398,\"code\":\"W5IRVG5JEBQOGNOL\",\"coverPhoto\":true,\"url\":\"https://image.speedhome.com/speedrent-backend/images/property/QQWZIJCO/W5IRVG5JEBQOGNOL-medium.jpg\",\"imageUrl\":\"https://image.speedhome.com/speedrent-backend/images/property/QQWZIJCO/W5IRVG5JEBQOGNOL-medium.jpg\",\"type\":\"NORMAL\",\"label\":\"\",\"altText\":\"Bright and airy 3-bedroom apartment with city views in Segambut, Kuala Lumpur.\"},{\"id\":1868714,\"propertyId\":299487,\"imageId\":1896394,\"code\":\"Z8P3TJX61DDOHUCL\",\"coverPhoto\":false,\"url\":\"https://image.speedhome.com/speedrent-backend/images/property/QQWZIJCO/Z8P3TJX61DDOHUCL-medium.jpg\",\"imageUrl\":\"https://image.speedhome.com/speedrent-backend/