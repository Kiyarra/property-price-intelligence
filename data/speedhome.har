oom Furnishings\\n▪ Air-conditioner + Fan + Window Ventilation\\n▪ Queen-size Bed\\n▪ Wardrobe + Study Desk & Chair\\n▪ Dual warm/cool lighting + Track Lights + Curtains\\n- Smart Door Lock\\n\\n➤ Book a viewing & request more photos\\n➤ Secure a quality room early – first come,&nbsp;first&nbsp;served!\",\"allRaces\":true,\"petFriendly\":true,\"minRentalDuration\":6,\"editorPick\":false,\"furnishes\":[\"kitchen_cabinet\",\"stove\",\"water_heater\",\"sofa\",\"bed_frame\",\"induction_cooker\",\"ac\",\"dining_table\",\"working_desk\",\"internet\",\"fridge\",\"curtain\",\"oven\",\"washing_machine\",\"microwave\",\"wardrobe\",\"tv\",\"mattress\"],\"utilityTypes\":[\"WATER\",\"ELECTRICITY\",\"INTERNET\"],\"facilities\":[\"security24hr\",\"covered_parking\",\"gym\",\"dobby\",\"basketball\",\"tennis\",\"swimming\",\"elevator\",\"restaurant\",\"sauna\",\"mart\",\"badminton\",\"playground\",\"bbq\"],\"images\":[{\"id\":1878715,\"propertyId\":292353,\"imageId\":1906456,\"code\":\"NIRVPC8MSEZMIHZB\",\"coverPhoto\":true,\"url\":\"https://image.speedhome.com/speedrent-backend/images/property/GALEJFHG/NIRVPC8MSEZMIHZB-medium.jpg\",\"imageUrl\":\"https://image.speedhome.com/speedrent-backend/images/property/GALEJFHG/NIRVPC8MSEZMIHZB-medium.jpg\",\"type\":\"NORMAL\",\"label\":\"\",\"altText\":\"Modern 1-bedroom condo with city view in Kuala Lumpur, fully furnished with A/C and kitchen appliances.\"},{\"id\":1804675,\"propertyId\":292353,\"imageId\":1831025,\"code\":\"YD3OJ7AU9YKYTJCQ\",\"coverPhoto\":false,\"url\":\"https://image.speedhome.com/speedrent-backend/images/property/GALEJFHG/YD3OJ7AU9YKYTJCQ-medium.jpg\",\"imageUrl\":\"https://image.speedhome.com/speedrent-backend/images/property/GALEJFHG/YD3OJ7AU9YKYTJCQ-medium.jpg\",\"type\":\"NORMAL\",\"label\":\"\",\"altText\":\"Fully furnished living area with modern grey sofas, 1BR Villa Putra Condominium, ideal KL rental.\"},{\"id\":1804676,\"propertyId\":292353,\"imageId\":1831026,\"code\":\"LSBQJINEWOBAASLK\",\"coverPhoto\":false